# Shared with the IST Legal app's server. It computes HMAC-SHA256(secret, userId) and
# passes it to the widget as user.hash, so posts show as "Verified".
FEEDBACK_IDENTITY_SECRET=

# Other sites allowed to post feedback, comma-separated, for example
# https://istlegal.ai,https://app.istlegal.ai
FEEDBACK_ALLOWED_ORIGINS=

# Optional: a Postgres connection string to use instead of SQLite. Needed on
# Netlify to keep data. Create the tables with db/migrations/*.sql first.
DATABASE_URL=

# Where the SQLite file lives (when not on Postgres). Defaults to ./data/feedback.db
FEEDBACK_DB_PATH=

# Turns on the AI assistant in the messenger. Without it, messages go
# straight to the team.
ANTHROPIC_API_KEY=

# Optional: the Claude model the assistant uses (default claude-opus-5-5).
# claude-sonnet-5-5 costs less.
FEEDBACK_AI_MODEL=

# Optional: set to false to turn the assistant off while keeping the key.
FEEDBACK_AI_ENABLED=
